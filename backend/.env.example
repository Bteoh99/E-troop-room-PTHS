# Copy this file to backend/.env and change what you need. Lines starting with # are ignored.
# Settings already set in Windows/Linux environment variables win over this file.

# Port the app listens on. Phones open http://<laptop-ip>:PORT
PORT=3001

# Where automatic backups go (relative paths are inside the backend folder).
# A Google Drive for desktop folder in "Mirror files" mode or a USB stick works, e.g.
# BACKUP_DIR=C:\Users\Scouts\My Drive\Store Room Backups
BACKUP_DIR=data/backups

# Hour of the day (0-23) for the daily backup; one is also made every time the server starts.
BACKUP_HOUR=21

# How many daily backups to keep (oldest are deleted).
BACKUP_KEEP=30

# Advanced (normally leave out):
# DB_PATH=data/store.db
# CONFIG_PATH=data/config.json
# HOST=0.0.0.0
# FRONTEND_DIST=../frontend/dist
