{
  "name": "e-troop-store-room-backend",
  "version": "0.1.0",
  "private": true,
  "description": "e-Troop Store Room API + laptop server: inventory by rack coordinate, Excel import, scan matching, leader PIN",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "set-pin": "node scripts/set-pin.js",
    "backup": "node scripts/backup.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "multer": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
